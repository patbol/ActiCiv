{
  "name": "@acticiv/citizen",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "ACTICIV_BUILD_TARGET=demo next dev --hostname 127.0.0.1 --port 3000",
    "build": "ACTICIV_BUILD_TARGET=prod next build",
    "start": "ACTICIV_BUILD_TARGET=prod next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "ACTICIV_BUILD_TARGET=prod next typegen && tsc --noEmit",
    "build:demo": "ACTICIV_BUILD_TARGET=demo next build",
    "start:demo": "ACTICIV_BUILD_TARGET=demo next start --hostname 127.0.0.1 --port 3000"
  },
  "dependencies": {
    "@acticiv/backend": "workspace:*",
    "@acticiv/shared": "workspace:*",
    "@acticiv/types": "workspace:*",
    "@acticiv/ui": "workspace:*",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
