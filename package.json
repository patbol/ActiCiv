{
  "name": "acticiv-workspace",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:bundles",
    "verify:full": "pnpm verify && pnpm db:test && pnpm test:integration && pnpm test:e2e && pnpm test:e2e:prod && pnpm security:sast && pnpm artifact:check && pnpm audit --audit-level high && ACTICIV_SCAN_ARTIFACTS=1 pnpm secrets:check",
    "test:integration": "node --test --test-concurrency=1 integration/*.test.mjs && vitest run --config vitest.integration.config.ts",
    "dev": "pnpm --parallel --filter @acticiv/citizen --filter @acticiv/pro dev",
    "build": "pnpm --filter @acticiv/citizen build && pnpm --filter @acticiv/pro build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm build:demo && playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:status": "supabase status",
    "db:test": "node scripts/check-db-tests.mjs",
    "db:provision": "node scripts/provision-dev.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "verify:bundles": "node scripts/check-client-bundles.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:coverage": "vitest run --coverage",
    "quality:collect": "node tooling/quality/cli.ts collect",
    "quality:snapshot": "node tooling/quality/cli.ts snapshot",
    "quality:evaluate": "node tooling/quality/cli.ts evaluate",
    "quality:report": "node tooling/quality/cli.ts report",
    "quality:compare": "node tooling/quality/cli.ts compare",
    "quality:flakiness": "node tooling/quality/cli.ts flakiness",
    "build:demo": "pnpm --filter @acticiv/citizen build:demo && pnpm --filter @acticiv/pro build:demo",
    "security:sast": "node tooling/quality/assurance-cli.ts sast",
    "security:dast:baseline": "node tooling/quality/assurance-cli.ts dast",
    "artifact:check": "node tooling/quality/assurance-cli.ts artifact",
    "performance:measure": "node tooling/quality/assurance-cli.ts performance",
    "performance:compare": "node tooling/quality/assurance-cli.ts compare",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
